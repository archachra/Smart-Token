# SmartToken Environment Configuration

# 1. Environment & Server
NODE_ENV=production
PORT=3001
JWT_SECRET=replace_with_a_secure_random_64_character_secret

# 2. Database (PostgreSQL 16+)
# Supply DATABASE_URL for cloud hosting (Render, Railway, Neon, Supabase, etc.)
DATABASE_URL=postgresql://postgres:password@localhost:5432/smarttoken_db

# Or use individual PG parameters for local connection:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=yourpassword
# SMARTTOKEN_DB_NAME=smarttoken_db

# 3. Speech-to-Text (Groq Whisper)
# Required for speech-to-text recording transcription in classroom participation
GROQ_API_KEY=your_groq_api_key_here
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIPTION_LANGUAGE=en
GROQ_TRANSCRIPTION_PROMPT=Classroom discussion in English and Hinglish.

# 4. AI Evaluation (Groq / Gemini)
# Used for evaluating student participation audio and assignment submissions
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EVALUATION_MODEL=gemini-2.0-flash
GROQ_EVALUATION_MODEL=openai/gpt-oss-120b

# 5. Optional Client Cross-Origin
# Set if frontend is hosted on a different domain than the backend
# CLIENT_ORIGIN=https://my-smarttoken-frontend.vercel.app
