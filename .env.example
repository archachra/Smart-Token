# Server authentication
JWT_SECRET=replace-with-a-long-random-secret

# Required for Groq-hosted speech-to-text. Leave unset to keep recordings valid
# while marking transcription as FAILED with a configuration error.
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GEMINI_API_KEY=
GEMINI_EVALUATION_MODEL=gemini-2.0-flash
